  remember_token                              String?                     @db.VarChar(100)
  created_at                                  DateTime?                   @db.Timestamp(0)
  updated_at                                  DateTime?                   @db.Timestamp(0)
  uuid                                        String                      @unique(map: "users_uuid_unique") @db.Uuid
  phone                                       String?                     @unique(map: "users_phone_unique") @db.VarChar(20)
  phone_verified_at                           DateTime?                   @db.Timestamp(0)
  avatar                                      String?                     @db.VarChar(500)
  cover_image                                 String?                     @db.VarChar(500)
  role                                        String                      @default("user") @db.VarChar(20)
  status                                      String                      @default("active") @db.VarChar(20)
  bio                                         String?
  address                                     String?                     @db.VarChar(500)
  province_id                                 BigInt?
  district_id                                 BigInt?
  balance                                     Decimal                     @default(0) @db.Decimal(15, 2)
  total_listings                              Int                         @default(0)
  total_sold                                  Int                         @default(0)
  rating                                      Decimal                     @default(0) @db.Decimal(3, 2)
  review_count                                Int                         @default(0)
  license_number                              String?                     @db.VarChar(100)
  /// Đánh dấu tài khoản demo (dữ liệu tự sinh cho seed/demo, không phải người dùng thật) —
  /// dùng để ẩn nút gọi trên UI công khai. SĐT tự sinh đúng định dạng thật có thể trùng một
  /// người Việt Nam thật ngoài đời không liên quan gì tới nền tảng.
  is_demo                                     Boolean                     @default(false)
  agency_name                                 String?                     @db.VarChar(255)
  /// Khoá ngoại tới bảng agencies. Giữ song song agency_name (ô chữ tự do cũ) để dữ liệu
  /// đã nhập không mất; chỗ nào có agency_id thì ưu tiên dùng nó.
  agency_id                                   BigInt?
  website                                     String?                     @db.VarChar(500)
  facebook                                    String?                     @db.VarChar(500)
  zalo                                        String?                     @db.VarChar(50)
  last_login_at                               DateTime?                   @db.Timestamp(0)
  banners                                     banners[]
  conversation_participants                   conversation_participants[]
  messages                                    messages[]
  notifications                               notifications[]
  oauth_accounts                              oauth_accounts[]
  otp_codes                                   otp_codes[]
  post_comments                               post_comments[]
  post_views                                  post_views[]
  posts                                       posts[]
  projects_projects_agent_idTousers           projects[]                  @relation("projects_agent_idTousers")
  projects_projects_user_idTousers            projects[]                  @relation("projects_user_idTousers")
  properties                                  properties[]
  property_views                              property_views[]
  reports                                     reports[]
  reviews_reviews_agent_idTousers             reviews[]                   @relation("reviews_agent_idTousers")
  reviews_reviews_reviewer_idTousers          reviews[]                   @relation("reviews_reviewer_idTousers")
  saved_properties                            saved_properties[]
  subscriptions                               subscriptions[]
  transactions                                transactions[]
  agencies                                    agencies?                   @relation(fields: [agency_id], references: [id], onUpdate: NoAction, map: "users_agency_id_foreign")
  districts                                   districts?                  @relation(fields: [district_id], references: [id], onUpdate: NoAction, map: "users_district_id_foreign")
  provinces                                   provinces?                  @relation(fields: [province_id], references: [id], onUpdate: NoAction, map: "users_province_id_foreign")
  verifications_verifications_admin_idTousers verifications[]             @relation("verifications_admin_idTousers")
  verifications_verifications_user_idTousers  verifications[]             @relation("verifications_user_idTousers")

  @@index([province_id], map: "users_province_id_index")
  @@index([role], map: "users_role_index")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
