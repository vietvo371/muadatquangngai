generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL KHÔNG đặt ở đây nữa — runtime dùng adapter PrismaPg
  // (src/lib/db.ts, đọc DATABASE_URL pooler), migrate/introspect dùng datasource.url
  // trong prisma.config.ts (đọc DIRECT_URL trực tiếp).
}

model banners {
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(255)
  slug        String    @unique(map: "banners_slug_unique") @db.VarChar(255)
  type        String    @db.VarChar(50)
  position    String    @db.VarChar(50)
  image_url   String    @db.VarChar(500)
  link_url    String?   @db.VarChar(500)
  link_target String    @default("_self") @db.VarChar(20)
  content     String?
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  starts_at   DateTime? @db.Timestamp(0)
  ends_at     DateTime? @db.Timestamp(0)
  click_count Int       @default(0)
  view_count  Int       @default(0)
  created_by  BigInt?
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  deleted_at  DateTime? @db.Timestamp(0)
  users       users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "banners_created_by_foreign")

  @@index([starts_at, ends_at], map: "banners_starts_at_ends_at_index")
  @@index([type, position, is_active], map: "banners_type_position_is_active_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model categories {
  id         BigInt       @id @default(autoincrement())
  name       String       @db.VarChar(255)
  slug       String       @unique(map: "categories_slug_unique") @db.VarChar(255)
  type       String       @db.VarChar(20)
  icon       String?      @db.VarChar(100)
  sort_order Int          @default(0)
  is_active  Boolean      @default(true)
  created_at DateTime?    @db.Timestamp(0)
  updated_at DateTime?    @db.Timestamp(0)
  properties properties[]

  @@index([slug], map: "categories_slug_index")
  @@index([type], map: "categories_type_index")
}

model conversation_participants {
  conversation_id BigInt
  user_id         BigInt
  unread_count    Int           @default(0)
  last_read_at    DateTime?     @db.Timestamp(0)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "conversation_participants_conversation_id_foreign")
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "conversation_participants_user_id_foreign")

  @@id([conversation_id, user_id])
}

model conversations {
  id                        BigInt                      @id @default(autoincrement())
  uuid                      String                      @unique(map: "conversations_uuid_unique") @db.Uuid
  property_id               BigInt?
  last_message              String?
  last_message_at           DateTime?                   @db.Timestamp(0)
  created_at                DateTime?                   @db.Timestamp(0)
  updated_at                DateTime?                   @db.Timestamp(0)
  conversation_participants conversation_participants[]
  properties                properties?                 @relation(fields: [property_id], references: [id], onUpdate: NoAction, map: "conversations_property_id_foreign")
  messages                  messages[]

  @@index([last_message_at], map: "conversations_last_message_at_index")
}

model districts {
  id          BigInt       @id @default(autoincrement())
  province_id BigInt
  name        String       @db.VarChar(100)
  code        String       @unique(map: "districts_code_unique") @db.VarChar(20)
  slug        String       @db.VarChar(100)
  created_at  DateTime?    @db.Timestamp(0)
  updated_at  DateTime?    @db.Timestamp(0)
  provinces   provinces    @relation(fields: [province_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "districts_province_id_foreign")
  projects    projects[]
  properties  properties[]
  users       users[]
  wards       wards[]
  agencies    agencies[]

  @@index([province_id], map: "districts_province_id_index")
  @@index([slug], map: "districts_slug_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model features {
  id                BigInt              @id @default(autoincrement())
  name              String              @db.VarChar(100)
  icon              String?             @db.VarChar(50)
  group_type        String?             @db.VarChar(50)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  property_features property_features[]
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model messages {
  id              BigInt        @id @default(autoincrement())
  conversation_id BigInt
  sender_id       BigInt
  type            String        @default("text") @db.VarChar(20)
  content         String
  attachment_url  String?       @db.VarChar(500)
  is_read         Boolean       @default(false)
  read_at         DateTime?     @db.Timestamp(0)
  created_at      DateTime?     @db.Timestamp(0)
  updated_at      DateTime?     @db.Timestamp(0)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_conversation_id_foreign")
  users           users         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_sender_id_foreign")

  @@index([conversation_id], map: "messages_conversation_id_index")
  @@index([created_at], map: "messages_created_at_index")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  type       String    @db.VarChar(100)
  title      String    @db.VarChar(255)
  body       String?
  data       Json?
  is_read    Boolean   @default(false)
  read_at    DateTime? @db.Timestamp(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_id_foreign")

  @@index([user_id], map: "notifications_user_id_index")
  @@index([user_id, is_read], map: "notifications_user_id_is_read_index")
}

model oauth_accounts {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt
  provider      String   @db.VarChar(20)
  provider_id   String   @db.VarChar(255)
  access_token  String?
  refresh_token String?
  created_at    DateTime @default(now()) @db.Timestamp(0)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oauth_accounts_user_id_foreign")

  @@unique([provider, provider_id], map: "oauth_accounts_provider_provider_id_unique")
}

model otp_codes {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt?
  phone      String?   @db.VarChar(20)
  email      String?   @db.VarChar(255)
  code       String?   @db.VarChar(6)
  otp        String?   @db.VarChar(100)
  type       String?   @db.VarChar(20)
  token      String?   @db.VarChar(100)
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  is_used    Boolean   @default(false)
  used_at    DateTime? @db.Timestamp(0)
  expires_at DateTime  @db.Timestamp(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "otp_codes_user_id_foreign")

  @@index([phone], map: "otp_codes_phone_index")
  @@index([user_id], map: "otp_codes_user_id_index")
}

model packages {
  id              BigInt          @id @default(autoincrement())
  name            String          @db.VarChar(100)
  type            String          @db.VarChar(20)
  price           Decimal         @db.Decimal(12, 0)
  duration_days   Int
  highlight_color String?         @db.VarChar(20)
  features        Json?
  sort_order      Int             @default(0)
  is_active       Boolean         @default(true)
  created_at      DateTime?       @db.Timestamp(0)
  updated_at      DateTime?       @db.Timestamp(0)
  subscriptions   subscriptions[]
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement())
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model post_categories {
  id                    BigInt            @id @default(autoincrement())
  name                  String            @db.VarChar(100)
  slug                  String            @unique(map: "post_categories_slug_unique") @db.VarChar(100)
  description           String?
  icon                  String?           @db.VarChar(50)
  sort_order            Int               @default(0) @db.SmallInt
  is_active             Boolean           @default(true)
  parent_id             BigInt?
  created_at            DateTime?         @db.Timestamp(0)
  updated_at            DateTime?         @db.Timestamp(0)
  post_categories       post_categories?  @relation("post_categoriesTopost_categories", fields: [parent_id], references: [id], onUpdate: NoAction, map: "post_categories_parent_id_foreign")
  other_post_categories post_categories[] @relation("post_categoriesTopost_categories")
  posts                 posts[]

  @@index([is_active], map: "post_categories_is_active_index")
  @@index([sort_order], map: "post_categories_sort_order_index")
}

model post_comments {
  id                  BigInt          @id @default(autoincrement())
  post_id             BigInt
  user_id             BigInt
  parent_id           BigInt?
  content             String
  is_approved         Boolean         @default(false)
  created_at          DateTime?       @db.Timestamp(0)
  updated_at          DateTime?       @db.Timestamp(0)
  post_comments       post_comments?  @relation("post_commentsTopost_comments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "post_comments_parent_id_foreign")
  other_post_comments post_comments[] @relation("post_commentsTopost_comments")
  posts               posts           @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "post_comments_post_id_foreign")
  users               users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "post_comments_user_id_foreign")

  @@index([is_approved], map: "post_comments_is_approved_index")
  @@index([post_id], map: "post_comments_post_id_index")
  @@index([user_id], map: "post_comments_user_id_index")
}

model post_views {
  id         BigInt   @id @default(autoincrement())
  post_id    BigInt
  user_id    BigInt?
  ip_address String?  @db.VarChar(45)
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamp(0)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "post_views_post_id_foreign")
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "post_views_user_id_foreign")

  @@index([created_at], map: "post_views_created_at_index")
  @@index([post_id], map: "post_views_post_id_index")
}

model posts {
  id               BigInt           @id @default(autoincrement())
  uuid             String           @unique(map: "posts_uuid_unique") @db.Uuid
  slug             String           @unique(map: "posts_slug_unique") @db.VarChar(500)
  user_id          BigInt
  category_id      BigInt?
  type             String           @default("news") @db.VarChar(20)
  status           String           @default("draft") @db.VarChar(20)
  title            String           @db.VarChar(500)
  excerpt          String?
  content          String
  thumbnail        String?          @db.VarChar(500)
  tags             Json?
  view_count       Int              @default(0)
  is_featured      Boolean          @default(false)
  published_at     DateTime?        @db.Timestamp(0)
  meta_title       String?          @db.VarChar(255)
  meta_description String?          @db.VarChar(500)
  seo_keywords     String?          @db.VarChar(500)
  created_at       DateTime?        @db.Timestamp(0)
  updated_at       DateTime?        @db.Timestamp(0)
  deleted_at       DateTime?        @db.Timestamp(0)
  post_comments    post_comments[]
  post_views       post_views[]
  post_categories  post_categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "posts_category_id_foreign")
  users            users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "posts_user_id_foreign")

  @@index([category_id], map: "posts_category_id_index")
  @@index([is_featured], map: "posts_is_featured_index")
  @@index([published_at], map: "posts_published_at_index")
  @@index([status], map: "posts_status_index")
  @@index([type], map: "posts_type_index")
  @@index([type, status, published_at], map: "posts_type_status_published_at_index")
  @@index([user_id], map: "posts_user_id_index")
}

model price_histories {
  id          BigInt     @id @default(autoincrement())
  property_id BigInt
  price       Decimal    @db.Decimal(20, 0)
  changed_at  DateTime   @default(now()) @db.Timestamp(0)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "price_histories_property_id_foreign")

  @@index([property_id], map: "price_histories_property_id_index")
}

model projects {
  id                             BigInt                    @id @default(autoincrement())
  uuid                           String                    @unique(map: "projects_uuid_unique") @db.Uuid
  slug                           String                    @unique(map: "projects_slug_unique") @db.VarChar(500)
  user_id                        BigInt
  name                           String                    @db.VarChar(500)
  developer                      String?                   @db.VarChar(255)
  description                    String?
  thumbnail                      String?
  status                         String                    @default("upcoming") @db.VarChar(20)
  // VarChar(30) — đủ chỗ cho slug dài nhất trong PROJECT_CATEGORIES (@/lib/project-type),
  // vd. "khu-nghi-duong-sinh-thai" (24 ký tự). VarChar(20) cũ tràn khi migrate LOẠI HÌNH
  // sang khớp 7 mục menu "Dự án" (Notion "SỬA WEBSITE 17/07").
  type                           String                    @db.VarChar(30)
  province_id                    BigInt
  district_id                    BigInt
  ward_id                        BigInt?
  address                        String                    @db.VarChar(500)
  total_area                     Decimal?                  @db.Decimal(12, 2)
  total_units                    Int?
  total_blocks                   Int?
  total_floors                   Int?
  price_from                     Decimal?                  @db.Decimal(20, 0)
  price_to                       Decimal?                  @db.Decimal(20, 0)
  legal                          String?
  handover_date                  DateTime?                 @db.Date
  construction_progress          Int?
  utilities                      Json?
  view_count                     Int                       @default(0)
  created_at                     DateTime?                 @db.Timestamp(0)
  updated_at                     DateTime?                 @db.Timestamp(0)
  deleted_at                     DateTime?                 @db.Timestamp(0)
  location                       Unsupported("geography")?
  agent_id                       BigInt?
  construction_note              String?                   @db.VarChar(500)
  floor_plans                    Json?
  latitude                       Decimal?                  @db.Decimal(10, 6)
  longitude                      Decimal?                  @db.Decimal(10, 6)
  nearby_places                  Json?
  users_projects_agent_idTousers users?                    @relation("projects_agent_idTousers", fields: [agent_id], references: [id], onUpdate: NoAction, map: "projects_agent_id_foreign")
  districts                      districts                 @relation(fields: [district_id], references: [id], onUpdate: NoAction, map: "projects_district_id_foreign")
  provinces                      provinces                 @relation(fields: [province_id], references: [id], onUpdate: NoAction, map: "projects_province_id_foreign")
  users_projects_user_idTousers  users                     @relation("projects_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "projects_user_id_foreign")

  @@index([location], map: "idx_projects_location", type: Gist)
  @@index([district_id], map: "projects_district_id_index")
  @@index([province_id], map: "projects_province_id_index")
  @@index([status], map: "projects_status_index")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model properties {
  id                BigInt                    @id @default(autoincrement())
  uuid              String                    @unique(map: "properties_uuid_unique") @db.Uuid
  slug              String                    @unique(map: "properties_slug_unique") @db.VarChar(500)
  user_id           BigInt
  category_id       BigInt
  project_id        BigInt?
  type              String                    @db.VarChar(10)
  status            String                    @default("pending") @db.VarChar(20)
  is_vip            String                    @default("normal") @db.VarChar(20)
  vip_expired_at    DateTime?                 @db.Timestamp(0)
  title             String                    @db.VarChar(500)
  description       String
  thumbnail         String?                   @db.VarChar(500)
  price             Decimal                   @db.Decimal(20, 0)
  price_unit        String                    @default("total") @db.VarChar(20)
  price_negotiable  Boolean                   @default(false)
  area              Decimal                   @db.Decimal(10, 2)
  area_floor        Decimal?                  @db.Decimal(10, 2)
  area_land         Decimal?                  @db.Decimal(10, 2)
  floors            Int?                      @db.SmallInt
  bedrooms          Int?                      @db.SmallInt
  bathrooms         Int?                      @db.SmallInt
  // Số nhà vệ sinh — tách riêng khỏi bathrooms, chỉ dùng cho nhóm kho/nhà xưởng.
  toilets           Int?                      @db.SmallInt
  parking           Boolean                   @default(false)
  direction         String?                   @db.VarChar(20)
  balcony_direction String?                   @db.VarChar(20)
  furniture         String                    @default("none") @db.VarChar(20)
  interior          String?
  legal             String?                   @db.VarChar(20)
  legal_note        String?                   @db.VarChar(500)
  province_id       BigInt
  district_id       BigInt
  ward_id           BigInt?
  street            String?                   @db.VarChar(255)
  address           String                    @db.VarChar(500)
  road_width        Decimal?                  @db.Decimal(5, 2)
  facade            Decimal?                  @db.Decimal(5, 2)
  depth             Decimal?                  @db.Decimal(5, 2)
  meta_title        String?                   @db.VarChar(255)
  meta_description  String?                   @db.VarChar(500)
  // Liên hệ riêng của từng tin — mặc định lấy từ tài khoản nhưng cho người đăng sửa,
  // vì người bán có thể muốn để số môi giới hoặc người nhà thay vì số tài khoản.
  contact_name      String?                   @db.VarChar(255)
  contact_phone     String?                   @db.VarChar(20)
  contact_email     String?                   @db.VarChar(255)
  contact_address   String?                   @db.VarChar(500)
  view_count        Int                       @default(0)
  contact_count     Int                       @default(0)
  save_count        Int                       @default(0)
  expired_at        DateTime?                 @db.Timestamp(0)
  published_at      DateTime?                 @db.Timestamp(0)
  created_at        DateTime?                 @db.Timestamp(0)
  updated_at        DateTime?                 @db.Timestamp(0)
  deleted_at        DateTime?                 @db.Timestamp(0)
  location          Unsupported("geography")?
  latitude          Decimal?                  @db.Decimal(10, 6)
  longitude         Decimal?                  @db.Decimal(10, 6)
  conversations     conversations[]
  price_histories   price_histories[]
  categories        categories                @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "properties_category_id_foreign")
  districts         districts                 @relation(fields: [district_id], references: [id], onUpdate: NoAction, map: "properties_district_id_foreign")
  provinces         provinces                 @relation(fields: [province_id], references: [id], onUpdate: NoAction, map: "properties_province_id_foreign")
  users             users                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "properties_user_id_foreign")
  property_features property_features[]
  property_media    property_media[]
  property_views    property_views[]
  reviews           reviews[]
  saved_properties  saved_properties[]
  subscriptions     subscriptions[]

  @@index([location], map: "idx_properties_location", type: Gist)
  @@index([area], map: "properties_area_index")
  @@index([category_id], map: "properties_category_id_index")
  @@index([district_id], map: "properties_district_id_index")
  @@index([is_vip, vip_expired_at], map: "properties_is_vip_vip_expired_at_index")
  @@index([price], map: "properties_price_index")
  @@index([province_id], map: "properties_province_id_index")
  @@index([published_at], map: "properties_published_at_index")
  @@index([status], map: "properties_status_index")
  @@index([type], map: "properties_type_index")
  @@index([user_id], map: "properties_user_id_index")
  @@index([ward_id], map: "properties_ward_id_index")
}

model property_features {
  property_id BigInt
  feature_id  BigInt
  features    features   @relation(fields: [feature_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "property_features_feature_id_foreign")
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "property_features_property_id_foreign")

  @@id([property_id, feature_id])
}

model property_media {
  id           BigInt     @id @default(autoincrement())
  property_id  BigInt
  type         String     @default("image") @db.VarChar(20)
  image_type   String?    @db.VarChar(30)
  url          String     @db.VarChar(500)
  thumbnail    String?    @db.VarChar(500)
  caption      String?    @db.VarChar(255)
  is_primary   Boolean    @default(false)
  sort_order   Int        @default(0)
  created_at   DateTime?  @db.Timestamp(0)
  updated_at   DateTime?  @db.Timestamp(0)
  source       String?    @db.VarChar(100)
  photographer String?    @db.VarChar(255)
  properties   properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "property_media_property_id_foreign")

  @@index([property_id], map: "property_media_property_id_index")
}

model property_views {
  id          BigInt     @id @default(autoincrement())
  property_id BigInt
  user_id     BigInt?
  ip_address  String?    @db.VarChar(45)
  user_agent  String?
  created_at  DateTime   @default(now()) @db.Timestamp(0)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "property_views_property_id_foreign")
